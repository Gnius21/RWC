<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Regional Weather Centre — Caribbean</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Barlow+Condensed:wght@300;400;500;600;700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>

<style>
:root{
  --bg:#020d18; --panel:#061828; --card:rgba(6,24,42,0.96);
  --border:rgba(55,130,200,0.14); --border-bright:rgba(85,193,255,0.22);
  --text:#fff; --muted:#8aabcc;
  --accent:#55c1ff; --accent-strong:#1b7cff; --accent-dim:rgba(85,193,255,0.12);
  --alert:#ff5f5f; --alert-dim:rgba(255,95,95,0.08);
  --ok:#3fcf82; --ok-dim:rgba(63,207,130,0.08);
  --warn:#f59e0b;
  --radius:10px; --radius-lg:14px;
  --shadow:0 16px 40px rgba(0,0,0,0.55);
  --shadow-sm:0 4px 16px rgba(0,0,0,0.35);
  --widget-width:270px;
  --mono:'Space Mono', ui-monospace, monospace;
  --sans:'Barlow', system-ui, sans-serif;
  --cond:'Barlow Condensed', system-ui, sans-serif;
  --th-bg:rgba(8,30,56,0.97); --raw-bg:rgba(4,16,28,0.8);
  --statusbar-bg:rgba(4,16,28,0.5); --table-card-bg:rgba(6,24,42,0.6);
  --station-row-bg1:rgba(10,30,54,0.9); --station-row-bg2:rgba(6,20,38,0.9);
  --glow-accent:0 0 24px rgba(85,193,255,0.12);
}
:root.night{
  --bg:#080400; --panel:#0f0800; --card:rgba(14,8,0,0.98);
  --border:rgba(100,50,0,0.2); --border-bright:rgba(160,80,0,0.22);
  --text:#fff5e0; --muted:#7a6040;
  --accent:#cc8800; --accent-strong:#aa6600; --accent-dim:rgba(180,110,0,0.12);
  --alert:#ff4040; --alert-dim:rgba(255,64,64,0.1);
  --ok:#28a060; --ok-dim:rgba(40,160,96,0.1);
  --th-bg:rgba(18,10,0,0.99); --raw-bg:rgba(10,5,0,0.95);
  --statusbar-bg:rgba(10,5,0,0.8); --table-card-bg:rgba(14,8,0,0.85);
  --station-row-bg1:rgba(18,10,0,0.95); --station-row-bg2:rgba(12,6,0,0.95);
  --glow-accent:0 0 20px rgba(160,80,0,0.1);
  --shadow:0 16px 40px rgba(0,0,0,0.85); --shadow-sm:0 4px 16px rgba(0,0,0,0.7);
}
:root.night body::before{
  background:
    radial-gradient(ellipse 900px 500px at 10% 0%, rgba(120,40,0,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 600px 400px at 90% 80%, rgba(100,30,0,0.05) 0%, transparent 55%);
}

*,*::before,*::after{box-sizing:border-box;}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);overflow-x:hidden;transition:background .4s,color .3s;}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 900px 500px at 10% 0%, rgba(27,124,255,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 600px 400px at 90% 80%, rgba(85,193,255,0.04) 0%, transparent 55%);
}
body::after{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:repeating-linear-gradient(0deg, transparent 0 2px, rgba(0,0,0,0.03) 2px 4px);
}

.page{width:100%;position:relative;z-index:1;padding:14px 18px;display:flex;flex-direction:column;align-items:center;gap:14px;min-height:100vh;}

/* ── TOP ROW ── */
.top-row{width:100%;max-width:1240px;display:grid;grid-template-columns:var(--widget-width) 1fr auto;align-items:center;gap:14px;}

.weather-widget{
  border-radius:var(--radius-lg);background:var(--card);
  box-shadow:var(--shadow),var(--glow-accent);
  border:1px solid var(--border-bright);overflow:hidden;position:relative;
}
.weather-widget::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--accent-strong),var(--accent),transparent);
}
.widget-head{
  padding:11px 14px;display:flex;gap:10px;align-items:center;
  background:linear-gradient(90deg,rgba(27,124,255,0.18),rgba(27,124,255,0.04));
  border-bottom:1px solid var(--border);
}
.widget-head .icon{font-size:18px;line-height:1;}
.widget-head .title{font-family:var(--cond);font-weight:700;font-size:15px;letter-spacing:0.5px;color:var(--accent);text-transform:uppercase;}
.widget-content{padding:14px;}
.vis-wrap{display:flex;align-items:center;gap:10px;}
.status-dot{
  width:9px;height:9px;border-radius:50%;background:var(--ok);flex-shrink:0;
  box-shadow:0 0 0 3px var(--ok-dim),0 0 8px var(--ok);
  animation:pulse-ok 2.5s ease-in-out infinite;
}
.status-dot.low{background:var(--alert);box-shadow:0 0 0 3px var(--alert-dim),0 0 8px var(--alert);animation:pulse-alert 1.2s ease-in-out infinite;}
@keyframes pulse-ok{0%,100%{opacity:1}50%{opacity:.6}}
@keyframes pulse-alert{0%,100%{opacity:1}50%{opacity:.4}}
.vis-value{font-family:var(--cond);font-weight:800;font-size:1.7rem;line-height:1;color:#fff;}
.vis-unit{font-family:var(--cond);font-weight:400;font-size:1rem;color:var(--muted);margin-left:2px;}
.timestamp{margin-top:5px;color:var(--muted);font-size:11px;font-family:var(--mono);display:block;}

/* ── HEADER ── */
.header-block{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;}
.header-title{
  font-family:var(--cond);font-size:22px;letter-spacing:2px;font-weight:800;
  color:var(--accent);text-transform:uppercase;margin:0;
  animation:rwcTitleGlow 4s ease-in-out infinite;
}
@keyframes rwcTitleGlow{
  0%,100%{text-shadow:0 0 24px rgba(85,193,255,0.3);}
  50%{text-shadow:0 0 36px rgba(85,193,255,0.55), 0 0 8px rgba(85,193,255,0.4);}
}
:root.night .header-title{animation:rwcTitleGlowNight 4s ease-in-out infinite;}
@keyframes rwcTitleGlowNight{
  0%,100%{text-shadow:0 0 24px rgba(160,80,0,0.4);}
  50%{text-shadow:0 0 38px rgba(160,80,0,0.65);}
}
.header-sub{font-family:var(--cond);font-size:11px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;}
.header-clocks{display:flex;gap:28px;align-items:center;}
.clock-group{display:flex;flex-direction:column;align-items:center;gap:2px;}
.clock-label{font-family:var(--cond);font-size:10px;letter-spacing:2.5px;color:var(--muted);text-transform:uppercase;}
.clock-time{font-family:var(--mono);font-size:28px;color:#fff;font-weight:700;letter-spacing:1px;text-shadow:0 0 20px rgba(85,193,255,0.25);}
.clock-date{font-family:var(--cond);font-size:12px;color:var(--muted);}
.clock-sep{width:1px;height:44px;background:linear-gradient(180deg,transparent,var(--border-bright),transparent);}

/* ── BUTTONS ── */
.controls-wrap{display:flex;flex-direction:column;gap:7px;align-items:flex-end;}
.btn-primary{
  padding:8px 14px;border-radius:8px;border:1px solid rgba(27,124,255,0.3);
  background:linear-gradient(180deg,rgba(27,124,255,0.9),rgba(11,90,200,0.9));
  color:#fff;cursor:pointer;font-family:var(--cond);font-weight:700;font-size:13px;
  letter-spacing:0.8px;text-transform:uppercase;
  box-shadow:0 4px 14px rgba(27,124,255,0.25),inset 0 1px 0 rgba(255,255,255,0.12);
  height:34px;display:inline-flex;align-items:center;gap:8px;
  transition:all 0.15s ease;white-space:nowrap;position:relative;overflow:hidden;
}
.btn-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.18),transparent);transform:translateX(-100%);transition:transform .55s ease;pointer-events:none;}
.btn-primary:hover::before{transform:translateX(100%);}
.btn-primary:hover{box-shadow:0 6px 20px rgba(27,124,255,0.35);}
.btn-primary:active{transform:translateY(1px);}
.btn-primary[disabled]{opacity:.5;cursor:not-allowed;}
:root.night .btn-primary{
  background:linear-gradient(180deg,rgba(140,70,0,0.9),rgba(100,46,0,0.9));
  border-color:rgba(160,80,0,0.35);
  box-shadow:0 4px 14px rgba(140,70,0,0.2),inset 0 1px 0 rgba(255,200,100,0.08);
}
.btn-glow{box-shadow:0 0 18px rgba(85,193,255,0.35),0 0 4px rgba(85,193,255,0.5),inset 0 1px 0 rgba(255,255,255,0.12) !important;animation:rwcGlowPulse 3s ease-in-out infinite;}
:root.night .btn-glow{box-shadow:0 0 18px rgba(204,136,0,0.45),0 0 4px rgba(204,136,0,0.55) !important;}
@keyframes rwcGlowPulse{0%,100%{filter:brightness(1);}50%{filter:brightness(1.08);}}

.btn-ghost{
  padding:7px 12px;border-radius:8px;border:1px solid var(--border);
  background:rgba(255,255,255,0.02);color:var(--accent);cursor:pointer;
  font-family:var(--cond);font-size:12px;letter-spacing:0.8px;text-transform:uppercase;
  font-weight:600;height:34px;transition:all 0.15s ease;white-space:nowrap;
}
.btn-ghost:hover{background:rgba(85,193,255,0.06);border-color:var(--border-bright);}
.btn-row{display:flex;gap:7px;align-items:center;}

/* ══════════════════════════════════════
   TABS — animated active state
   ══════════════════════════════════════ */
.tabs{
  width:100%;max-width:1240px;display:flex;gap:6px;
  padding:8px;border-radius:14px;
  background:linear-gradient(180deg,rgba(6,24,42,0.7),rgba(4,16,28,0.6));
  border:1px solid var(--border);
  backdrop-filter:blur(12px);
  box-shadow:var(--shadow-sm), inset 0 1px 0 rgba(255,255,255,0.04);
  position:relative;overflow:hidden;
}
/* Drifting sheen across the tab bar */
.tabs::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(120deg,transparent 30%,rgba(85,193,255,0.04) 50%,transparent 70%);
  background-size:200% 100%;
  animation:tabsSheen 9s linear infinite;
  pointer-events:none;
}
:root.night .tabs::before{background:linear-gradient(120deg,transparent 30%,rgba(204,136,0,0.04) 50%,transparent 70%);background-size:200% 100%;}
@keyframes tabsSheen{
  0%{background-position:200% 0;}
  100%{background-position:-100% 0;}
}

.tab-btn{
  flex:1;padding:13px 16px;border:none;background:transparent;
  color:var(--muted);font-family:var(--cond);font-weight:700;font-size:13px;
  letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;
  border-radius:10px;
  transition:color .3s ease, background .3s ease, transform .2s ease;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  position:relative;overflow:hidden;z-index:1;
}
.tab-btn:hover{
  color:var(--accent);
  background:rgba(85,193,255,0.05);
  transform:translateY(-1px);
}
:root.night .tab-btn:hover{background:rgba(204,136,0,0.06);}

/* Active tab — multi-layer effect */
.tab-btn.active{
  color:#fff;
  background:linear-gradient(180deg,rgba(27,124,255,0.95),rgba(11,90,200,0.95));
  box-shadow:
    0 6px 22px rgba(27,124,255,0.4),
    0 0 0 1px rgba(85,193,255,0.5),
    inset 0 1px 0 rgba(255,255,255,0.2),
    inset 0 -1px 0 rgba(0,0,0,0.2);
  text-shadow:0 0 14px rgba(255,255,255,0.5);
  transform:translateY(-1px);
  animation:tabActivePulse 2.8s ease-in-out infinite;
}
:root.night .tab-btn.active{
  background:linear-gradient(180deg,rgba(180,90,0,0.95),rgba(120,55,0,0.95));
  box-shadow:
    0 6px 22px rgba(160,80,0,0.45),
    0 0 0 1px rgba(204,136,0,0.55),
    inset 0 1px 0 rgba(255,200,100,0.2),
    inset 0 -1px 0 rgba(0,0,0,0.25);
  text-shadow:0 0 14px rgba(255,200,100,0.5);
  animation:tabActivePulseNight 2.8s ease-in-out infinite;
}
@keyframes tabActivePulse{
  0%,100%{box-shadow:0 6px 22px rgba(27,124,255,0.4),0 0 0 1px rgba(85,193,255,0.5),inset 0 1px 0 rgba(255,255,255,0.2),inset 0 -1px 0 rgba(0,0,0,0.2);}
  50%{box-shadow:0 8px 30px rgba(27,124,255,0.55),0 0 0 1px rgba(85,193,255,0.7),0 0 24px rgba(85,193,255,0.25),inset 0 1px 0 rgba(255,255,255,0.25),inset 0 -1px 0 rgba(0,0,0,0.2);}
}
@keyframes tabActivePulseNight{
  0%,100%{box-shadow:0 6px 22px rgba(160,80,0,0.45),0 0 0 1px rgba(204,136,0,0.55),inset 0 1px 0 rgba(255,200,100,0.2),inset 0 -1px 0 rgba(0,0,0,0.25);}
  50%{box-shadow:0 8px 30px rgba(160,80,0,0.6),0 0 0 1px rgba(204,136,0,0.75),0 0 24px rgba(204,136,0,0.3),inset 0 1px 0 rgba(255,200,100,0.25),inset 0 -1px 0 rgba(0,0,0,0.25);}
}

/* Animated underline */
.tab-btn.active::after{
  content:'';position:absolute;left:14px;right:14px;bottom:5px;height:2px;
  background:linear-gradient(90deg,transparent,#fff,transparent);
  border-radius:2px;
  animation:tabUnderline 2.5s ease-in-out infinite;
  box-shadow:0 0 8px rgba(255,255,255,0.6);
}
@keyframes tabUnderline{
  0%,100%{opacity:0.4;transform:scaleX(0.6);}
  50%{opacity:1;transform:scaleX(1);}
}

/* Sweeping shimmer */
.tab-btn.active::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.25),transparent);
  transform:translateX(-100%);
  animation:tabShimmer 3.5s ease-in-out infinite;
  pointer-events:none;
}
@keyframes tabShimmer{
  0%{transform:translateX(-100%);}
  60%,100%{transform:translateX(100%);}
}

/* Click ripple */
.tab-btn.activating{
  animation:tabRipple .6s ease-out;
}
@keyframes tabRipple{
  0%{box-shadow:0 0 0 0 rgba(85,193,255,0.6),0 6px 22px rgba(27,124,255,0.4),0 0 0 1px rgba(85,193,255,0.5),inset 0 1px 0 rgba(255,255,255,0.2);}
  100%{box-shadow:0 0 0 24px rgba(85,193,255,0),0 6px 22px rgba(27,124,255,0.4),0 0 0 1px rgba(85,193,255,0.5),inset 0 1px 0 rgba(255,255,255,0.2);}
}

/* Icon pop */
.tab-icon{
  font-size:14px;
  transition:transform .3s cubic-bezier(.34,1.56,.64,1), filter .3s;
}
.tab-btn.active .tab-icon{
  transform:scale(1.2) rotate(-4deg);
  filter:drop-shadow(0 0 6px rgba(255,255,255,0.5));
}
.tab-btn.activating .tab-icon{
  animation:tabIconBounce .6s cubic-bezier(.34,1.56,.64,1);
}
@keyframes tabIconBounce{
  0%{transform:scale(1) rotate(0);}
  50%{transform:scale(1.4) rotate(-8deg);}
  100%{transform:scale(1.2) rotate(-4deg);}
}

/* Badge */
.tab-badge{
  font-family:var(--mono);font-size:9px;letter-spacing:0.5px;
  padding:2px 6px;border-radius:4px;
  background:rgba(0,0,0,0.25);color:rgba(255,255,255,0.6);
  transition:all .3s;
}
.tab-btn.active .tab-badge{
  background:rgba(255,255,255,0.18);
  color:#fff;
  box-shadow:0 0 8px rgba(255,255,255,0.3);
}

/* Panel transitions */
.tab-panel{
  animation:panelEnter .4s cubic-bezier(.16,1,.3,1) both;
}
@keyframes panelEnter{
  from{opacity:0;transform:translateY(8px) scale(0.995);}
  to{opacity:1;transform:translateY(0) scale(1);}
}
.tab-panel.leaving{
  animation:panelLeave .2s ease-in both;
}
@keyframes panelLeave{
  from{opacity:1;transform:translateY(0);}
  to{opacity:0;transform:translateY(-6px);}
}

/* ── CONTENT ── */
.content-wrapper{width:100%;max-width:1240px;}
.table-wrapper{width:100%;margin:10px 0;}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;padding:0 2px;flex-wrap:wrap;gap:8px;}
.section-title{
  font-family:var(--cond);font-size:14px;font-weight:700;letter-spacing:2.5px;
  text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:8px;
}
.section-title::before{content:'';width:16px;height:2px;background:linear-gradient(90deg,var(--accent-strong),transparent);border-radius:2px;}

.table-card{
  border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--border);
  box-shadow:var(--shadow-sm);background:var(--table-card-bg);
  backdrop-filter:blur(8px);
}
table{width:100%;border-collapse:collapse;font-family:var(--mono);color:#fff;font-size:20px;}
thead{position:sticky;top:0;z-index:2;}
th{
  background:var(--th-bg);color:var(--muted);font-weight:700;
  font-size:11px;text-transform:uppercase;letter-spacing:2px;padding:13px 16px;
  border-bottom:1px solid var(--border-bright);font-family:var(--cond);
  text-align:center;white-space:nowrap;
}
th:first-child{text-align:left;padding-left:20px;}
td{
  padding:16px;border-bottom:1px solid rgba(32,52,80,0.5);
  text-align:center;vertical-align:middle;font-size:19px;color:#fff;
  transition:background 0.2s;letter-spacing:0.3px;
}
td:first-child{text-align:left;padding-left:20px;}
tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(85,193,255,0.04);}
:root.night tbody tr:hover td{background:rgba(204,136,0,0.05);}

td.station{font-family:var(--cond);font-weight:800;color:var(--accent);font-size:26px;letter-spacing:1.5px;}
td.station .icao-flag{font-size:22px;margin-right:10px;vertical-align:-2px;filter:drop-shadow(0 0 8px rgba(85,193,255,0.3));}
:root.night td.station .icao-flag{filter:drop-shadow(0 0 8px rgba(204,136,0,0.3));}
td.time{font-size:17px;color:#fff;font-family:var(--mono);}
td.wind{font-size:18px;color:#fff;font-weight:700;}
td.clouds{font-size:17px;color:#fff;}

tr.stale td{opacity:.5;}
td.alert{color:var(--alert) !important;background:var(--alert-dim) !important;}
td.cloud-critical{color:var(--alert) !important;background:var(--alert-dim) !important;box-shadow:inset 0 0 16px rgba(255,95,95,0.08);}
td.wx-critical{color:var(--alert) !important;background:var(--alert-dim) !important;}

.time-updated{background:rgba(27,124,255,0.18) !important;color:#fff !important;font-weight:700;transition:all 0.6s;}
.time-updated.dim{opacity:0.4 !important;}

tr.raw td{
  background:var(--raw-bg);text-align:left;color:#fff;
  padding:10px 20px;white-space:pre-wrap;font-size:12px;
  border-bottom:1px solid rgba(32,52,80,0.6);font-family:var(--mono);line-height:1.6;
}
.raw-current{font-size:12px;color:#fff;display:block;white-space:pre-wrap;opacity:0.92;}
.raw-past{margin-top:6px;font-size:11px;color:rgba(200,220,255,0.55);display:block;padding-top:6px;border-top:1px solid rgba(32,52,80,0.5);}

.status-bar{
  display:flex;justify-content:space-between;align-items:center;
  padding:8px 16px;background:var(--statusbar-bg);border-top:1px solid var(--border);
  font-size:11px;color:var(--muted);font-family:var(--mono);
}
.status-bar .dot-live{
  width:6px;height:6px;border-radius:50%;background:var(--ok);
  display:inline-block;margin-right:6px;box-shadow:0 0 6px var(--ok);animation:pulse-ok 2s infinite;
}

/* ── TAF ── */
#taf-table td.station{color:var(--accent);font-size:26px;font-family:var(--cond);font-weight:800;letter-spacing:1.5px;}
tr.taf-raw-row td{
  background:var(--raw-bg);text-align:left;color:#fff;
  padding:10px 20px;white-space:pre-wrap;font-size:12px;
  border-bottom:1px solid rgba(32,52,80,0.6);font-family:var(--mono);line-height:1.65;
}
.taf-raw-text{font-size:12px;color:rgba(200,225,255,0.85);display:block;white-space:pre-wrap;word-break:break-word;}
tr.taf-change-row td{
  padding:10px 16px;border-bottom:1px solid rgba(32,52,80,0.35);
  font-size:15px;color:rgba(200,225,255,0.82);background:rgba(4,14,28,0.55);
}
tr.taf-change-row td:first-child{
  padding-left:20px;font-family:var(--cond);font-weight:700;font-size:13px;
  letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap;
}
tr.taf-change-row.type-TEMPO td:first-child{color:#f59e0b;}
tr.taf-change-row.type-BECMG td:first-child{color:#3fcf82;}
tr.taf-change-row.type-PROB td:first-child{color:#a78bfa;}
tr.taf-change-row.type-FM td:first-child{color:#55c1ff;}

/* ── SYNOP — METAR-styled ── */
#synop-table{font-size:18px;}
#synop-table th{font-size:11px;padding:13px 16px;letter-spacing:2px;}
#synop-table td{font-size:17px;padding:16px;color:#fff;vertical-align:middle;}
#synop-table td.station{
  font-family:var(--cond);font-weight:800;color:var(--accent);
  font-size:24px;letter-spacing:1.5px;white-space:nowrap;padding-left:20px;
}
.synop-flag{font-size:22px;margin-right:10px;vertical-align:-2px;filter:drop-shadow(0 0 8px rgba(85,193,255,0.3));}
:root.night .synop-flag{filter:drop-shadow(0 0 8px rgba(204,136,0,0.3));}
#synop-table td.time{font-size:16px;color:#fff;font-family:var(--mono);}
#synop-table td.code{font-family:var(--mono);font-size:14px;color:rgba(200,225,255,0.75);letter-spacing:0.5px;}
tr.synop-raw-row td{
  background:var(--raw-bg);text-align:left;color:#fff;
  padding:10px 20px;white-space:pre-wrap;font-size:12px;
  border-bottom:1px solid rgba(32,52,80,0.6);font-family:var(--mono);line-height:1.6;
}
.synop-raw-text{font-size:12px;color:rgba(200,225,255,0.8);display:block;white-space:pre-wrap;word-break:break-word;}

/* ── STATIONS ── */
.stations-card{
  margin-top:8px;padding:16px;border-radius:var(--radius-lg);
  background:rgba(6,24,42,0.6);border:1px solid var(--border);backdrop-filter:blur(8px);
}
.stations-header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;}
.stations-title{font-family:var(--cond);font-size:18px;font-weight:800;letter-spacing:1.5px;color:var(--accent);text-transform:uppercase;}
.stations-sub{font-family:var(--cond);font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-top:2px;}
.stations{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px;}

.station-row{
  padding:14px;border-radius:10px;
  background:linear-gradient(135deg,var(--station-row-bg1),var(--station-row-bg2));
  border:1px solid rgba(55,130,200,0.1);transition:all 0.2s;position:relative;overflow:hidden;
}
.station-row::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(85,193,255,0.2),transparent);}
.station-row:hover{border-color:rgba(85,193,255,0.18);transform:translateY(-1px);}
.station-top{display:flex;justify-content:space-between;align-items:center;}
.station-name{font-family:var(--cond);font-weight:700;font-size:15px;color:var(--accent);letter-spacing:0.5px;display:flex;align-items:center;gap:6px;}
.station-flag{font-size:18px;line-height:1;filter:drop-shadow(0 0 6px rgba(85,193,255,0.3));}
:root.night .station-flag{filter:drop-shadow(0 0 6px rgba(204,136,0,0.3));}
.station-time{font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:2px;}
.param{
  background:rgba(255,255,255,0.03);padding:7px 11px;border-radius:7px;
  font-size:12px;color:var(--muted);display:inline-flex;flex-direction:column;
  align-items:center;gap:2px;border:1px solid rgba(255,255,255,0.04);
}
.param .label{font-family:var(--cond);font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);}
.param .value{font-family:var(--cond);font-weight:700;font-size:16px;color:#d0e8ff;}
.params-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px;}
.wind-rose{width:70px;height:70px;flex-shrink:0;}
.wind-rose svg{width:100%;height:100%;}

.summary{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}
.pill{padding:5px 12px;border-radius:20px;background:rgba(255,255,255,0.03);border:1px solid var(--border);font-family:var(--cond);font-size:12px;color:var(--muted);}
.pill span{color:var(--accent);font-weight:700;}

.map-container{height:58vh;border-radius:10px;overflow:hidden;margin-top:12px;border:1px solid var(--border);}
#map{width:100%;height:100%;}
.legend{
  background:rgba(6,18,34,0.92);padding:10px 12px;border-radius:8px;
  color:var(--text);font-family:var(--cond);font-size:12px;
  border:1px solid var(--border);backdrop-filter:blur(8px);
}
.legend .row{display:flex;align-items:center;gap:8px;margin-bottom:5px;}
.legend .row:last-child{margin-bottom:0;}
.dot{width:11px;height:11px;border-radius:50%;flex-shrink:0;}
.dot.ok{background:var(--ok);box-shadow:0 0 6px var(--ok);}
.dot.warn{background:var(--alert);box-shadow:0 0 6px var(--alert);}
.dot.danger{background:#ff8a5b;box-shadow:0 0 6px #ff8a5b;}
.dot.error{background:#ffb3c7;box-shadow:0 0 6px #ffb3c7;}

.map-search{
  padding:8px 12px;border-radius:8px;border:1px solid var(--border);
  background:rgba(255,255,255,0.04);color:var(--text);font-family:var(--sans);
  font-size:13px;width:240px;outline:none;
}
.map-search:focus{border-color:var(--border-bright);}
.map-search::placeholder{color:var(--muted);}

/* Leaflet popup theming */
.leaflet-popup-content-wrapper, .leaflet-popup-tip{
  background:rgba(6,24,42,0.98) !important;color:var(--text) !important;
  border:1px solid var(--border-bright);box-shadow:var(--shadow);
}
:root.night .leaflet-popup-content-wrapper, :root.night .leaflet-popup-tip{
  background:rgba(14,8,0,0.98) !important;
}
.leaflet-popup-content{margin:0 !important;}
.leaflet-popup-close-button{color:var(--muted) !important;}

/* ── ATC ── */
.atc-card{border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--table-card-bg);backdrop-filter:blur(8px);padding:14px;box-shadow:var(--shadow-sm);}
.atc-players{display:flex;flex-direction:column;gap:10px;}
.atc-player{
  display:grid;grid-template-columns:auto 1fr auto auto;gap:14px;align-items:center;
  padding:12px 14px;border:1px solid var(--border);border-left:3px solid var(--accent);
  border-radius:var(--radius);
  background:linear-gradient(180deg,rgba(0,12,28,0.5),rgba(4,18,34,0.4));
  transition:border-color .2s,box-shadow .2s;
}
.atc-player:hover{border-color:var(--border-bright);}
.atc-player.playing{border-color:var(--border-bright);box-shadow:0 0 24px rgba(85,193,255,0.18);}
.atc-play-btn{
  width:46px;height:46px;border-radius:50%;
  border:1px solid var(--border-bright);
  background:linear-gradient(180deg,rgba(85,193,255,0.14),rgba(0,12,28,0.5));
  color:var(--accent);font-family:var(--cond);font-size:16px;font-weight:700;cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;
}
.atc-play-btn:hover{border-color:var(--accent);box-shadow:0 0 22px rgba(85,193,255,0.3);transform:scale(1.04);}
.atc-play-icon{display:inline-block;line-height:1;text-shadow:0 0 12px var(--accent);}
.atc-player.loading .atc-play-icon{animation:atcSpin 1s linear infinite;}
@keyframes atcSpin{to{transform:rotate(360deg);}}
.atc-info{min-width:0;}
.atc-label{font-family:var(--cond);font-size:16px;font-weight:700;letter-spacing:1.4px;color:var(--accent);display:flex;align-items:center;gap:8px;}
.atc-flag{font-size:18px;line-height:1;}
.atc-freq{font-family:var(--mono);font-size:11px;letter-spacing:1.6px;color:var(--muted);margin-top:3px;text-transform:uppercase;}
.atc-status{
  display:flex;align-items:center;gap:7px;
  font-family:var(--cond);font-size:11px;letter-spacing:2px;font-weight:700;
  text-transform:uppercase;color:var(--muted);
  padding:5px 10px;border:1px solid var(--border-bright);border-radius:4px;
  background:rgba(0,0,0,0.3);min-width:96px;
}
.atc-status-dot{width:7px;height:7px;border-radius:50%;background:var(--muted);}
.atc-player.loading .atc-status{color:#ffb347;border-color:#ffb347;}
.atc-player.loading .atc-status-dot{background:#ffb347;box-shadow:0 0 8px #ffb347;animation:atcDotPulse 1s ease-in-out infinite;}
.atc-player.playing .atc-status{color:#39ff8a;border-color:#39ff8a;}
.atc-player.playing .atc-status-dot{background:#39ff8a;box-shadow:0 0 10px #39ff8a;animation:atcDotPulse 1.6s ease-in-out infinite;}
.atc-player.error .atc-status{color:#ff6b6b;border-color:#ff6b6b;}
.atc-player.error .atc-status-dot{background:#ff6b6b;box-shadow:0 0 8px #ff6b6b;}
@keyframes atcDotPulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.atc-volume{display:flex;align-items:center;gap:8px;}
.atc-vol-icon{font-size:14px;opacity:.65;}
.atc-vol-slider{-webkit-appearance:none;appearance:none;width:100px;height:4px;background:var(--border-bright);border-radius:2px;outline:none;cursor:pointer;}
.atc-vol-slider::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px rgba(85,193,255,0.5);cursor:pointer;}
.atc-vol-slider::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px rgba(85,193,255,0.5);cursor:pointer;border:none;}

/* ── FOOTER ── */
.footer{width:100%;max-width:1240px;margin-top:20px;padding:14px 0;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(55,130,200,0.08);}
.footer-brand{font-family:var(--cond);font-size:13px;font-weight:700;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;}
.footer-note{font-family:var(--sans);font-size:11px;color:rgba(106,138,170,0.6);}

/* ── UTILS ── */
.hidden{display:none !important;}
.flash-blue{animation:flashBlue 500ms ease-in-out;}
@keyframes flashBlue{0%{background:rgba(27,124,255,0.2);}50%{background:rgba(27,124,255,0.3);}100%{background:transparent;}}

/* ── RESPONSIVE ── */
@media(max-width:960px){
  .top-row{grid-template-columns:1fr;gap:10px;}
  .header-clocks{gap:16px;}
  table{font-size:15px;}
  td{font-size:13px;padding:10px;}
  td.station{font-size:17px;}
  td.station .icao-flag{font-size:16px;}
  .clock-time{font-size:22px;}
  .tab-btn{padding:11px 8px;font-size:11px;letter-spacing:1px;}
  .tab-icon{font-size:13px;}
  .tab-badge{display:none;}
}
@media(max-width:700px){
  .atc-player{grid-template-columns:auto 1fr auto;grid-template-areas:"btn info status" "vol vol vol";gap:10px 12px;}
  .atc-play-btn{grid-area:btn;}
  .atc-info{grid-area:info;}
  .atc-status{grid-area:status;min-width:0;}
  .atc-volume{grid-area:vol;justify-content:flex-start;}
  .atc-vol-slider{flex:1;width:auto;max-width:220px;}
}
</style>
</head>
<body>
<div class="page" id="pageRoot">

  <!-- TOP ROW -->
  <div class="top-row" role="banner">
    <div class="weather-widget" id="bonaire-vis-widget" tabindex="0" aria-live="polite">
      <div class="widget-head"><span class="icon">👁</span><span class="title">Bonaire Visibility</span></div>
      <div class="widget-content">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
          <div class="vis-wrap">
            <div id="vis-status" class="status-dot"></div>
            <div>
              <div id="vis-value" class="vis-value">—</div>
              <span id="vis-timestamp" class="timestamp" style="display:none"></span>
              <span style="display:flex;gap:10px;margin-top:4px;font-family:var(--cond);font-size:10px;letter-spacing:1px;">
                <span style="color:var(--ok)">● ≥8 km</span>
                <span style="color:var(--warn)">● 2–8 km</span>
                <span style="color:var(--alert)">● &lt;2 km</span>
              </span>
            </div>
          </div>
          <button id="vis-refresh-btn" class="btn-primary" style="font-size:11px;padding:6px 10px;height:30px;">↻</button>
        </div>
      </div>
    </div>

    <div class="header-block">
      <div style="text-align:center;margin-bottom:4px;">
        <div class="header-sub">Caribbean</div>
        <div class="header-title">Regional Weather Centre</div>
      </div>
      <div class="header-clocks">
        <div class="clock-group"><div class="clock-label">Local</div><div id="local-clock" class="clock-time">--:--:--</div><div id="local-date" class="clock-date">--</div></div>
        <div class="clock-sep"></div>
        <div class="clock-group"><div class="clock-label">UTC</div><div id="utc-clock" class="clock-time">--:--:--</div><div id="utc-date" class="clock-date">--</div></div>
      </div>
    </div>

    <div class="controls-wrap">
      <div class="btn-row">
        <button id="mute-btn" class="btn-ghost" aria-pressed="false">🔊 Mute</button>
        <button id="test-btn" class="btn-ghost">⚗ Test</button>
        <button id="night-btn" class="btn-ghost" aria-pressed="false">🌙 Night</button>
      </div>
      <button id="refresh-btn" class="btn-primary btn-glow">↻ Refresh All</button>
    </div>
  </div>

  <!-- TABS -->
  <nav class="tabs" role="tablist" aria-label="Data sections">
    <button class="tab-btn active" data-tab="metar" role="tab"><span class="tab-icon">📡</span>METAR<span class="tab-badge">6</span></button>
    <button class="tab-btn" data-tab="taf" role="tab"><span class="tab-icon">📊</span>TAF<span class="tab-badge">3</span></button>
    <button class="tab-btn" data-tab="synop" role="tab"><span class="tab-icon">🌐</span>SYNOP<span class="tab-badge">4</span></button>
    <button class="tab-btn" data-tab="stations" role="tab"><span class="tab-icon">⊞</span>Stations</button>
    <button class="tab-btn" data-tab="atc" role="tab"><span class="tab-icon">🎙</span>Live ATC</button>
  </nav>

  <div class="content-wrapper">

    <!-- METAR -->
    <div id="tab-metar" class="tab-panel">
      <div class="section-header">
        <div class="section-title">METAR Observations</div>
        <button id="metar-refresh-btn" class="btn-primary" style="font-size:11px;height:30px;padding:6px 12px;">↻ METAR</button>
      </div>
      <div class="table-card">
        <table aria-label="METAR list">
          <thead><tr><th>ICAO</th><th>Time (Z)</th><th>Wind</th><th>Vis</th><th>Wx</th><th>Cloud</th><th>Temp / Dew</th><th>QNH (hPa / inHg)</th></tr></thead>
          <tbody id="metar"></tbody>
        </table>
        <div class="status-bar">
          <span><span class="dot-live"></span><span id="last-updated">METAR last updated: --:--</span></span>
          <span style="font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(106,138,170,0.5);">Auto-refresh 30s</span>
        </div>
      </div>
    </div>

    <!-- TAF -->
    <div id="tab-taf" class="tab-panel hidden">
      <div class="section-header">
        <div class="section-title">Terminal Aerodrome Forecast</div>
        <button id="taf-refresh-btn" class="btn-primary" style="font-size:11px;height:30px;padding:6px 12px;">↻ TAF</button>
      </div>
      <div class="table-card">
        <table id="taf-table" aria-label="TAF list">
          <thead><tr><th>ICAO</th><th>Valid (Z)</th><th>Wind</th><th>Vis</th><th>Wx</th><th>Cloud</th><th>Temp / Dew</th><th>QNH (hPa / inHg)</th></tr></thead>
          <tbody id="taf"></tbody>
        </table>
        <div class="status-bar"><span id="taf-updated" style="color:var(--muted)">TAF last updated: --:--</span></div>
      </div>
    </div>

    <!-- SYNOP -->
    <div id="tab-synop" class="tab-panel hidden">
      <div class="section-header">
        <div class="section-title">SYNOP Surface Reports</div>
        <button id="synop-refresh-btn" class="btn-primary" style="font-size:11px;height:30px;padding:6px 12px;">↻ SYNOP</button>
      </div>
      <div class="table-card">
        <table id="synop-table" aria-label="SYNOP list">
          <thead><tr><th>Source</th><th>Time (Z)</th><th>Bulletin Type</th><th>Stations</th></tr></thead>
          <tbody id="synop"></tbody>
        </table>
        <div class="status-bar"><span id="synop-updated" style="color:var(--muted)">SYNOP last updated: --:--</span></div>
      </div>
    </div>

    <!-- Stations -->
    <div id="tab-stations" class="tab-panel hidden">
      <section class="stations-card">
        <div class="stations-header">
          <div>
            <div class="stations-title">Stations Dashboard</div>
            <div class="stations-sub">Live surface observations · Wind roses · Map view</div>
          </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <span id="stationsLastFetched" style="color:var(--muted);font-size:11px;font-family:var(--mono);">Last fetched: —</span>
            <button id="toggleMap" class="btn-primary" style="font-size:11px;height:30px;padding:6px 12px;">🗺 Map View</button>
          </div>
        </div>
        <div id="stationsList" class="stations" aria-live="polite">
          <div style="padding:20px;color:var(--muted);font-family:var(--cond);letter-spacing:1px;text-transform:uppercase;font-size:12px;">Loading stations…</div>
        </div>
        <div class="summary">
          <div class="pill">Total: <span id="totalCount">0</span></div>
          <div class="pill">Alerts: <span id="alertCount">0</span></div>
          <div class="pill">Stale: <span id="staleCount">0</span></div>
          <div class="pill">Most recent: <span id="mostRecent">—</span></div>
        </div>
        <div id="stationsMapCard" class="hidden" style="margin-top:14px;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
            <div style="display:flex;gap:10px;align-items:center;">
              <input id="mapSearch" type="text" class="map-search" placeholder="Filter stations…"/>
              <span style="color:var(--muted);font-family:var(--mono);font-size:11px;" id="mapLastFetched">Last fetched: —</span>
            </div>
            <div class="legend">
              <div class="row"><div class="dot ok"></div><span>OK</span></div>
              <div class="row"><div class="dot warn"></div><span>Alert</span></div>
              <div class="row"><div class="dot danger"></div><span>Critical</span></div>
              <div class="row"><div class="dot error"></div><span>Stale</span></div>
            </div>
          </div>
          <div class="map-container"><div id="map"></div></div>
        </div>
      </section>
    </div>

    <!-- ATC -->
    <div id="tab-atc" class="tab-panel hidden">
      <div class="section-header"><div class="section-title">Live ATC — Curaçao · Aruba · Bonaire</div></div>
      <div class="atc-card">
        <div class="atc-players">
          <div class="atc-player" data-stream="https://d.liveatc.net/tncc3_twr">
            <button class="atc-play-btn" aria-label="Play TNCC TWR"><span class="atc-play-icon">▶</span></button>
            <div class="atc-info"><div class="atc-label"><span class="atc-flag">🇨🇼</span> TNCC · Hato Tower</div><div class="atc-freq">118.300 MHz · Curaçao</div></div>
            <div class="atc-status"><span class="atc-status-dot"></span><span class="atc-status-text">Idle</span></div>
            <div class="atc-volume"><span class="atc-vol-icon">🔊</span><input type="range" min="0" max="100" value="80" class="atc-vol-slider"/></div>
          </div>
          <div class="atc-player" data-stream="https://d.liveatc.net/tncc3_rdr1">
            <button class="atc-play-btn" aria-label="Play TNCC APP"><span class="atc-play-icon">▶</span></button>
            <div class="atc-info"><div class="atc-label"><span class="atc-flag">🇨🇼</span> TNCC · Hato Approach / Radar</div><div class="atc-freq">APP / RDR · Curaçao</div></div>
            <div class="atc-status"><span class="atc-status-dot"></span><span class="atc-status-text">Idle</span></div>
            <div class="atc-volume"><span class="atc-vol-icon">🔊</span><input type="range" min="0" max="100" value="80" class="atc-vol-slider"/></div>
          </div>
          <div class="atc-player" data-stream="https://d.liveatc.net/tnca">
            <button class="atc-play-btn" aria-label="Play TNCA TWR"><span class="atc-play-icon">▶</span></button>
            <div class="atc-info"><div class="atc-label"><span class="atc-flag">🇦🇼</span> TNCA · Aruba Tower</div><div class="atc-freq">118.000 MHz · Queen Beatrix</div></div>
            <div class="atc-status"><span class="atc-status-dot"></span><span class="atc-status-text">Idle</span></div>
            <div class="atc-volume"><span class="atc-vol-icon">🔊</span><input type="range" min="0" max="100" value="80" class="atc-vol-slider"/></div>
          </div>
          <div class="atc-player" data-stream="https://d.liveatc.net/tncb">
            <button class="atc-play-btn" aria-label="Play TNCB TWR"><span class="atc-play-icon">▶</span></button>
            <div class="atc-info"><div class="atc-label"><span class="atc-flag">🇧🇶</span> TNCB · Bonaire Tower</div><div class="atc-freq">118.700 MHz · Flamingo</div></div>
            <div class="atc-status"><span class="atc-status-dot"></span><span class="atc-status-text">Idle</span></div>
            <div class="atc-volume"><span class="atc-vol-icon">🔊</span><input type="range" min="0" max="100" value="80" class="atc-vol-slider"/></div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="footer">
    <div class="footer-brand">⬡ GNIUS · RWC</div>
    <div class="footer-note">Bonaire vis from KNMI · Auto-refresh 30s · TAF/SYNOP lazy-loaded</div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
(function(){
'use strict';

/* ── CONFIG ── */
const STATIONS=['TNCA','TNCB','TNCC','TNCM','SVMI','SVVA'];
const ICAO_FLAGS={TNCA:'🇦🇼',TNCB:'🇧🇶',TNCC:'🇨🇼',TNCM:'🇸🇽',SVMI:'🇻🇪',SVVA:'🇻🇪'};
const METAR_TPL='https://tgftp.nws.noaa.gov/data/observations/metar/stations/{ICAO}.TXT';
const TAF_TPL='https://tgftp.nws.noaa.gov/data/forecasts/taf/stations/{ICAO}.TXT';
const KNMI_URL='https://www.knmidc.org/weather/bonaire/?Current';
const METAR_REFRESH_MS=30000, VIS_REFRESH_MS=60000;
const TIMEOUT_MS=12000;
const FALLBACKS=[
  {prefix:'https://api.allorigins.win/get?url=',type:'json'},
  {prefix:'https://r.jina.ai/https://',type:'raw'}
];
const MAX_RETRIES=2;
const BACKOFF_BASE_MS=400;

/* ── DOM ── */
const $=id=>document.getElementById(id);
const metarTbody=$('metar'), tafTbody=$('taf'), synopTbody=$('synop');
const lastUpdatedEl=$('last-updated'), tafUpdatedEl=$('taf-updated'), synopUpdatedEl=$('synop-updated');
const visValueEl=$('vis-value'), visStatusEl=$('vis-status'), visTsEl=$('vis-timestamp');

/* ── STATE ── */
let mute=false, testMode=false;
const metarState={};
const loadedTabs={metar:false,taf:false,synop:false,stations:false,atc:true};
let svgIdCounter=0;

/* ── CLOCKS ── */
function pad(n){return n<10?'0'+n:''+n;}
function tickClocks(){
  const d=new Date();
  $('local-clock').textContent=`${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  $('local-date').textContent=`${pad(d.getDate())}-${pad(d.getMonth()+1)}-${d.getFullYear()}`;
  $('utc-clock').textContent=`${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}`;
  $('utc-date').textContent=`${pad(d.getUTCDate())}-${pad(d.getUTCMonth()+1)}-${d.getUTCFullYear()}`;
}
tickClocks(); setInterval(tickClocks,1000);
function nowStamp(){const d=new Date();return `${pad(d.getDate())}-${pad(d.getMonth()+1)}-${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;}

/* ── AUDIO (shared context) ── */
let _audioCtx=null;
function getAudioCtx(){
  if(_audioCtx) return _audioCtx;
  try{_audioCtx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){_audioCtx=null;}
  return _audioCtx;
}
function playBeep(){
  if(mute) return;
  const ctx=getAudioCtx(); if(!ctx) return;
  try{
    if(ctx.state==='suspended') ctx.resume();
    const o=ctx.createOscillator(),g=ctx.createGain();
    o.type='sine';o.frequency.value=880;g.gain.value=0.015;
    o.connect(g);g.connect(ctx.destination);
    o.start();o.stop(ctx.currentTime+0.1);
  }catch(e){}
}
function playCriticalAlarm(){
  if(mute) return;
  const ctx=getAudioCtx(); if(!ctx) return;
  try{
    if(ctx.state==='suspended') ctx.resume();
    const now=ctx.currentTime, g=ctx.createGain();
    g.gain.value=0.05; g.connect(ctx.destination);
    const o1=ctx.createOscillator(), o2=ctx.createOscillator();
    o1.type='sawtooth'; o2.type='sine';
    o1.frequency.setValueAtTime(520,now); o2.frequency.setValueAtTime(780,now);
    o1.connect(g); o2.connect(g);
    o1.start(now); o2.start(now);
    o1.frequency.exponentialRampToValueAtTime(880,now+0.12);
    o2.frequency.exponentialRampToValueAtTime(1200,now+0.12);
    o1.frequency.exponentialRampToValueAtTime(600,now+0.22);
    o2.frequency.exponentialRampToValueAtTime(900,now+0.22);
    o1.frequency.exponentialRampToValueAtTime(1000,now+0.30);
    o2.frequency.exponentialRampToValueAtTime(1400,now+0.30);
    o1.stop(now+0.7); o2.stop(now+0.7);
  }catch(e){}
}

/* ── FETCH ── */
async function fetchWithTimeout(url,timeout=TIMEOUT_MS){
  const ctrl=new AbortController(), id=setTimeout(()=>ctrl.abort(),timeout);
  try{
    const r=await fetch(url,{cache:'no-store',mode:'cors',signal:ctrl.signal});
    clearTimeout(id);
    return r;
  }catch(e){clearTimeout(id);throw e;}
}
async function robustFetchText(url){
  try{
    const r=await fetchWithTimeout(url);
    if(r){
      if(r.status===404||r.status===410) return {ok:false,permanent:true,error:'not found'};
      if(r.ok){const t=await r.text(); if(t&&t.trim()) return {ok:true,text:t.trim()};}
    }
  }catch(e){}
  try{
    const r=await fetchWithTimeout(FALLBACKS[0].prefix+encodeURIComponent(url));
    if(r&&r.ok){const j=await r.json(); if(j&&typeof j.contents==='string'&&j.contents.trim()) return {ok:true,text:j.contents.trim()};}
  }catch(e){}
  try{
    const stripped=url.replace(/^https?:\/\//,'');
    const r=await fetchWithTimeout(FALLBACKS[1].prefix+stripped, TIMEOUT_MS*2);
    if(r&&r.ok){const t=await r.text(); if(t&&t.trim()) return {ok:true,text:t.trim()};}
  }catch(e){}
  return {ok:false,error:'no content'};
}
async function fetchWithRetries(url,attempts=MAX_RETRIES){
  for(let i=0;i<attempts;i++){
    const o=await robustFetchText(url);
    if(o.ok) return o;
    if(o.permanent) return o;
    if(i<attempts-1){
      const ms=BACKOFF_BASE_MS*Math.pow(2,i)+Math.floor(Math.random()*200);
      await new Promise(r=>setTimeout(r,ms));
    }
  }
  return {ok:false,error:'fetch failed'};
}

/* ── KNMI VISIBILITY ── */
function extractKnmiVis(text){
  if(!text||!text.trim()) return null;
  const s=String(text).replace(/\u00A0/g,' ').replace(/\s+/g,' ');
  let m=s.match(/(?:Visibility|Visibiliteit|Zicht(?:baarheid)?)\s*\(?\s*km\s*\)?[^0-9]{0,30}([0-9]+(?:\.[0-9]+)?)\b/i);
  if(m) return {meters:Math.round(parseFloat(m[1])*1000),raw:m[0]};
  m=s.match(/(?:Visibility|Visibiliteit|Zicht(?:baarheid)?)\s*\(?\s*m\s*\)?[^0-9]{0,30}([0-9]{3,6})\b/i);
  if(m) return {meters:parseInt(m[1],10),raw:m[0]};
  m=s.match(/(?:Visibility|Visibiliteit|Zicht(?:baarheid)?)[^0-9]{0,30}([0-9]{3,6})\b/i);
  if(m) return {meters:parseInt(m[1],10),raw:m[0]};
  m=s.match(/\b([0-9]{3,6})\s?(?:m|meter|meters)\b/i);
  if(m) return {meters:parseInt(m[1],10),raw:m[0]};
  return null;
}
function applyVisColor(meters){
  visStatusEl.classList.remove('low');
  if(isNaN(meters)){visStatusEl.style.background='';visStatusEl.style.boxShadow='';visValueEl.style.color='';return;}
  let col,sh;
  if(meters>=8000){col='var(--ok)';sh='0 0 0 3px var(--ok-dim),0 0 8px var(--ok)';}
  else if(meters>=2000){col='var(--warn)';sh='0 0 0 3px rgba(245,158,11,0.15),0 0 8px var(--warn)';}
  else {col='var(--alert)';sh='0 0 0 3px var(--alert-dim),0 0 8px var(--alert)';visStatusEl.classList.add('low');}
  visStatusEl.style.background=col; visStatusEl.style.boxShadow=sh;
  visValueEl.style.color=col;
}
async function updateVis(){
  try{
    const out=await fetchWithRetries(KNMI_URL);
    if(!out.ok){visValueEl.textContent='—';applyVisColor(NaN);visTsEl.style.display='none';return;}
    const r=extractKnmiVis(out.text);
    if(!r){visValueEl.textContent='—';applyVisColor(NaN);visTsEl.textContent='Not found';visTsEl.style.display='block';return;}
    const m=r.meters;
    if(m>=1000) visValueEl.innerHTML=`<span style="font-size:2rem">${(m/1000).toFixed(1)}</span><span class="vis-unit"> km</span>`;
    else visValueEl.innerHTML=`<span style="font-size:1.7rem">${m}</span><span class="vis-unit"> m</span>`;
    applyVisColor(m);
    const inner=visValueEl.querySelector('span'); if(inner) inner.style.color='inherit';
    visTsEl.textContent=`Updated ${nowStamp()}`; visTsEl.style.display='block';
  }catch(e){console.error('updateVis',e);visValueEl.textContent='—';applyVisColor(NaN);}
}

/* ── METAR PARSING ── */
function cleanMetar(s){return String(s||'').replace(/\sRMK[\s\S]*/i,'').replace(/\s(?:TEMPO|BECMG|PROB\d{2}|FM\d{6})[\s\S]*/i,'').replace(/\bAUTO\b|\bCOR\b/gi,'').trim();}
function parseMetar(raw){
  const cleaned=cleanMetar(raw), tokens=cleaned.split(/\s+/);
  const time=tokens[1]||'--';
  const windBase=tokens.find(x=>/^(?:VRB|\d{3})\d{2}(?:G\d{2,3})?KT$/.test(x))||'/////KT';
  const varDir=tokens.find(x=>/^\d{3}V\d{3}$/.test(x));
  const wind=varDir?`${windBase} ${varDir}`:windBase;
  const visTokens=tokens.filter(x=>/^\d{4}(?:[NSEW]{1,2})?$/.test(x));
  const vis=visTokens.length?visTokens.join(' '):'--';
  const visMin=visTokens.length?Math.min(...visTokens.map(v=>parseInt(v,10)).filter(n=>!isNaN(n))):NaN;
  const wx=tokens.filter(x=>/^(?:\+|-)?(?:VC)?(?:TS|VCTS|VCSH|TSRA|SH|SHRA|RA|DZ|SN|FG|BR|HZ|SQ|PO)/.test(x)).join(' ')||'--';
  const cldMatch=cleaned.match(/((?:FEW|SCT|BKN|OVC)(?:\d{3}|\/{3})(?:TCU|CB)?)/gi)||[];
  const cld=cldMatch.join(' ')||'--';
  const td=tokens.find(x=>/^M?\d{2}\/M?\d{2}$/.test(x))||'--';
  const qp=tokens.find(x=>/^Q\d{4}$/.test(x))||null;
  let qnh='—';
  if(qp){const h=qp.slice(1);qnh=`${h} / ${(parseInt(h,10)*0.029529983).toFixed(2)}`;}
  const gustMatch=windBase.match(/G(\d{2,3})/);
  const gust=gustMatch?+gustMatch[1]:0;
  let age=0;
  if(/^\d{6}Z$/.test(time)){
    const now=new Date(),dd=+time.slice(0,2),hh=+time.slice(2,4),mm=+time.slice(4,6);
    const t=Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),dd,hh,mm);
    age=(Date.now()-t)/60000;
  }
  return{time,wind,windBase,vis,visTokens,visMin,wx,cld,td,qnh,gust,age,raw:cleaned};
}
function isWxCritical(wx){return /\b(?:VCTS|VCSH|TS|TSRA|SHRA)\b|(^|\s)[+-]\s*(?:SHRA|SH|RA|DZ|SN|FG|BR|HZ)/i.test(String(wx||''));}
function isCloudCB(s){return /(?:FEW|SCT|BKN|OVC)\d{3}(?:CB|TCU)/i.test(String(s||''));}

/* ── METAR TABLE ── */
function buildMetarTable(){
  metarTbody.innerHTML='';
  STATIONS.forEach(icao=>{
    metarState[icao]={lastTime:null,lastRaw:null,pastRaw:null,row:null,rawEl:null,pastEl:null,highlightTimeout:null};
    const tr=document.createElement('tr');
    tr.innerHTML=`<td class="station"><span class="icao-flag">${ICAO_FLAGS[icao]||''}</span>${icao}</td><td class="time">--</td><td class="wind">--</td><td>--</td><td class="wx">--</td><td class="clouds">--</td><td>--</td><td>--</td>`;
    const rr=document.createElement('tr'); rr.className='raw';
    rr.innerHTML=`<td colspan="8"><span class="raw-current"></span><span class="raw-past"></span></td>`;
    metarTbody.appendChild(tr); metarTbody.appendChild(rr);
    metarState[icao].row=tr;
    metarState[icao].rawEl=rr.querySelector('.raw-current');
    metarState[icao].pastEl=rr.querySelector('.raw-past');
  });
}
function markTimeUpdated(icao){
  const st=metarState[icao]; if(!st||!st.row) return;
  const tc=st.row.querySelector('td.time'); if(!tc) return;
  if(st.highlightTimeout){clearTimeout(st.highlightTimeout);st.highlightTimeout=null;}
  tc.classList.add('time-updated'); tc.classList.remove('dim');
  st.highlightTimeout=setTimeout(()=>{
    tc.classList.add('dim');
    setTimeout(()=>{tc.classList.remove('time-updated','dim');st.highlightTimeout=null;},700);
  },5*60*1000);
}
function renderMetar(icao,raw){
  if(!raw) return false;
  const lines=String(raw).split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  let metarLine=null;
  for(const ln of lines){if(ln.startsWith(icao)||/\b\d{6}Z\b/.test(ln)){metarLine=ln;break;}}
  if(!metarLine&&lines.length) metarLine=lines[lines.length-1];
  if(!metarLine) return false;
  const p=parseMetar(metarLine);
  const st=metarState[icao]; if(!st||!st.row) return false;
  const tds=st.row.querySelectorAll('td');
  [2,3,4,5].forEach(i=>tds[i].classList.remove('alert','cloud-critical','wx-critical'));
  st.row.classList.toggle('stale',p.age>120);
  if(st.lastRaw&&st.lastRaw!==metarLine) st.pastRaw=st.lastRaw;
  st.lastRaw=metarLine;
  const prevTime=st.lastTime; st.lastTime=p.time;
  const isNew=prevTime!==p.time;
  let timeDisplay='--';
  const m6=p.time.match(/^(\d{2})(\d{2})(\d{2})Z$/);
  if(m6) timeDisplay=`${m6[2]}:${m6[3]}Z`; else timeDisplay=p.time;
  tds[1].textContent=timeDisplay;
  tds[2].textContent=p.wind;
  tds[3].textContent=p.vis;
  tds[4].textContent=p.wx;
  tds[5].textContent=p.cld;
  tds[6].textContent=p.td;
  tds[7].textContent=p.qnh;
  if(st.rawEl) st.rawEl.textContent=st.lastRaw||'';
  if(st.pastEl){
    if(st.pastRaw){st.pastEl.style.display='block';st.pastEl.textContent=`Previous: ${st.pastRaw}`;}
    else{st.pastEl.style.display='none';st.pastEl.textContent='';}
  }
  const hasGust=p.gust>0;
  const wxCrit=isWxCritical(p.wx);
  const cloudFlag=isCloudCB(p.cld);
  if(isNew){playBeep();markTimeUpdated(icao);}
  if(hasGust&&isNew) tds[2].classList.add('alert');
  if(!isNaN(p.visMin)&&p.visMin<=5000) tds[3].classList.add('alert');
  if(wxCrit) tds[4].classList.add('alert','wx-critical');
  if(cloudFlag) tds[5].classList.add('cloud-critical');
  const criticalStation=p.gust>=35;
  const criticalGlobal=/\b(?:VCTS|TS|TSRA)\b/i.test(p.wx);
  if(isNew&&(criticalStation||criticalGlobal)) playCriticalAlarm();
  return true;
}
async function fetchMetarFor(icao){
  try{
    const url=METAR_TPL.replace('{ICAO}',icao);
    const out=await fetchWithRetries(url);
    if(!out.ok) return false;
    const lines=out.text.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    for(let i=lines.length-1;i>=0;i--){
      const ln=lines[i];
      if(ln.startsWith(icao)||/\b\d{6}Z\b/.test(ln)){
        if((icao==='SVMI'||icao==='SVVA')&&/\bAUTO\b/i.test(ln)) continue;
        renderMetar(icao,ln); return true;
      }
    }
    return false;
  }catch(e){console.error('METAR',icao,e);return false;}
}
async function refreshAllMetars(){
  const results=await Promise.all(STATIONS.map(s=>fetchMetarFor(s)));
  if(lastUpdatedEl) lastUpdatedEl.textContent=`Last updated: ${nowStamp()}`;
  return results.some(Boolean);
}

/* ── TAF ── */
function parseTafSeg(seg){
  const tok=seg.trim().split(/\s+/);
  const wb=tok.find(x=>/^(?:VRB|\d{3})\d{2}(?:G\d{2,3})?KT$/.test(x))||'--';
  const vd=tok.find(x=>/^\d{3}V\d{3}$/.test(x));
  const wind=wb==='--'?'--':(vd?`${wb} ${vd}`:wb);
  const vt=tok.filter(x=>/^\d{4}(?:[NSEW]{1,2})?$/.test(x)||x==='9999'||/^P\d+SM$/.test(x));
  const vis=vt.length?vt[0]:'--';
  const visNum=vis==='9999'||/^P/.test(vis)?9999:(parseInt(vis,10)||NaN);
  const wx=tok.filter(x=>/^(?:\+|-)?(?:VC)?(?:TS|VCTS|VCSH|TSRA|SH|SHRA|RA|DZ|SN|FG|BR|HZ|SQ|PO)/.test(x)).join(' ')||'--';
  const cm=seg.match(/((?:FEW|SCT|BKN|OVC)(?:\d{3}|\/{3})(?:TCU|CB)?)/gi)||[];
  const cld=cm.join(' ')||'--';
  const qp=tok.find(x=>/^Q\d{4}$/.test(x));
  let qnh='—'; if(qp){const h=qp.slice(1);qnh=`${h} / ${(parseInt(h,10)*0.029529983).toFixed(2)}`;}
  return{wind,windBase:wb,vis,visNum,wx,cld,qnh};
}
function parseTaf(rawText){
  if(!rawText) return null;
  const full=rawText.replace(/\r?\n/g,' ').replace(/\s{2,}/g,' ').trim();
  const valid=(full.match(/\b(\d{4}\/\d{4})\b/)||[])[1]||'--';
  const tm=[...full.matchAll(/T([XN])(M?\d{2})\/\d{4}Z/gi)];
  let tx=null,tn=null;
  for(const m of tm){const sgn=m[2].startsWith('M')?-1:1;const v=sgn*parseInt(m[2].replace('M',''),10);if(m[1].toUpperCase()==='X')tx=v;else tn=v;}
  let td='--';
  if(tx!==null&&tn!==null) td=`${tx}°/${tn}°`;
  else if(tx!==null) td=`TX ${tx}°`;
  else if(tn!==null) td=`TN ${tn}°`;
  const RE=/\b(TEMPO|BECMG|PROB\d{2}(?:\s+TEMPO)?|FM\d{6})\b/g;
  const sp=[]; let m;
  while((m=RE.exec(full))!==null) sp.push({idx:m.index,kw:m[1]});
  const baseEnd=sp.length?sp[0].idx:full.length;
  const base=parseTafSeg(full.slice(0,baseEnd));
  const changes=[];
  for(let i=0;i<sp.length;i++){
    const {idx,kw}=sp[i];
    const segEnd=i+1<sp.length?sp[i+1].idx:full.length;
    const body=full.slice(idx+kw.length,segEnd).trim();
    const seg=parseTafSeg(body);
    let type='TEMPO',label=kw;
    if(/^FM/.test(kw)){type='FM';const h=kw.slice(4,8);label=`FM ${h.slice(0,2)}:${h.slice(2)}`;}
    else if(/^BECMG/.test(kw)){type='BECMG';label='BECMG';}
    else if(/^PROB\d{2}\s+TEMPO/.test(kw)){type='TEMPO';label=kw;}
    else if(/^PROB\d{2}/.test(kw)){type='PROB';label=kw;}
    const pm=body.match(/^(\d{4}\/\d{4})/);
    changes.push({type,label,period:pm?pm[1]:'',...seg});
  }
  return{valid,td,base,changes,rawFull:full};
}
function sanitize(text){
  if(!text) return '';
  return String(text).split('\n').map(l=>l.trim()).filter(l=>{
    if(/^\s*URL\s*Source\s*:/i.test(l)) return false;
    if(/^\s*Published\s*Time\s*:/i.test(l)) return false;
    if(/^\s*Markdown\s*Content\s*:/i.test(l)) return false;
    if(/^https?:\/\//i.test(l)) return false;
    return l.length>0;
  }).join('\n');
}

const TAF_ICAOS=STATIONS.slice(0,3);
function buildTafTable(){
  tafTbody.innerHTML='';
  TAF_ICAOS.forEach(icao=>{
    const tr=document.createElement('tr');
    tr.dataset.icao=icao; tr.dataset.tafBase='1';
    tr.innerHTML=`<td class="station"><span class="icao-flag">${ICAO_FLAGS[icao]||''}</span>${icao}</td><td class="time">--</td><td class="wind">--</td><td>--</td><td class="wx">--</td><td class="clouds">--</td><td>--</td><td>--</td>`;
    const rr=document.createElement('tr'); rr.className='taf-raw-row'; rr.dataset.icao=icao;
    rr.innerHTML=`<td colspan="8"><span class="taf-raw-text"></span></td>`;
    tafTbody.appendChild(tr); tafTbody.appendChild(rr);
  });
}
function applyTafAlerts(tds,seg){
  [2,3,4,5].forEach(i=>tds[i].classList.remove('alert','cloud-critical','wx-critical'));
  if(seg.windBase!=='--'&&/G\d{2,3}KT/i.test(seg.windBase)) tds[2].classList.add('alert');
  if(!isNaN(seg.visNum)&&seg.visNum<=5000) tds[3].classList.add('alert');
  if(isWxCritical(seg.wx)) tds[4].classList.add('alert','wx-critical');
  if(/(?:FEW|SCT|BKN|OVC)\d{3}(?:CB|TCU)/i.test(seg.cld)) tds[5].classList.add('cloud-critical');
}
function renderTafRow(icao,rawText){
  if(!rawText) return;
  const parsed=parseTaf(sanitize(rawText)); if(!parsed) return;
  const tr=tafTbody.querySelector(`tr[data-taf-base][data-icao="${icao}"]`); if(!tr) return;
  const tds=tr.querySelectorAll('td');
  tds[1].textContent=parsed.valid;
  tds[2].textContent=parsed.base.wind;
  tds[3].textContent=parsed.base.vis;
  tds[4].textContent=parsed.base.wx;
  tds[5].textContent=parsed.base.cld;
  tds[6].textContent=parsed.td;
  tds[7].textContent=parsed.base.qnh;
  applyTafAlerts(tds,parsed.base);
  const rr=tafTbody.querySelector(`tr.taf-raw-row[data-icao="${icao}"]`);
  if(rr){const sp=rr.querySelector('.taf-raw-text');if(sp)sp.textContent=parsed.rawFull;}
  tafTbody.querySelectorAll(`tr.taf-change-row[data-icao="${icao}"]`).forEach(r=>r.remove());
  parsed.changes.forEach(ch=>{
    const cr=document.createElement('tr');
    cr.className=`taf-change-row type-${ch.type}`; cr.dataset.icao=icao;
    cr.innerHTML=`<td>${ch.label}</td><td class="time">--</td><td class="wind">--</td><td>--</td><td class="wx">--</td><td class="clouds">--</td><td>--</td><td>--</td>`;
    const ctds=cr.querySelectorAll('td');
    ctds[1].textContent=ch.period||'--';
    ctds[2].textContent=ch.wind;
    ctds[3].textContent=ch.vis;
    ctds[4].textContent=ch.wx;
    ctds[5].textContent=ch.cld;
    ctds[6].textContent='—';
    ctds[7].textContent=ch.qnh;
    applyTafAlerts(ctds,ch);
    if(rr) tafTbody.insertBefore(cr,rr); else tafTbody.appendChild(cr);
  });
}
async function loadTafRow(icao){
  try{
    const out=await fetchWithRetries(TAF_TPL.replace('{ICAO}',icao));
    if(out.ok){renderTafRow(icao,out.text);if(tafUpdatedEl)tafUpdatedEl.textContent=`TAF last updated: ${nowStamp()}`;}
  }catch(e){console.error('TAF',icao,e);}
}
async function loadAllTafs(){await Promise.all(TAF_ICAOS.map(i=>loadTafRow(i)));}

/* ── SYNOP ── */
const SYNOP_SOURCES=[
  {key:'tnca-si',  icao:'TNCA', flag:ICAO_FLAGS.TNCA, label:'TNCA · SINU50', type:'SI', url:'https://tgftp.nws.noaa.gov/data/raw/si/sinu50.tnca..txt'},
  {key:'tnca-sm',  icao:'TNCA', flag:ICAO_FLAGS.TNCA, label:'TNCA · SMNU50', type:'SM', url:'https://tgftp.nws.noaa.gov/data/raw/sm/smnu50.tnca..txt'},
  {key:'tncc-si',  icao:'TNCC', flag:ICAO_FLAGS.TNCC, label:'TNCC · SICA20', type:'SI', url:'https://tgftp.nws.noaa.gov/data/raw/si/sica20.tncc..txt'},
  {key:'tncc-sm',  icao:'TNCC', flag:ICAO_FLAGS.TNCC, label:'TNCC · SMCA01', type:'SM', url:'https://tgftp.nws.noaa.gov/data/raw/sm/smca01.tncc..txt'}
];
function buildSynopTable(){
  synopTbody.innerHTML='';
  SYNOP_SOURCES.forEach(s=>{
    const tr=document.createElement('tr');
    tr.dataset.key=s.key;
    tr.innerHTML=`<td class="station"><span class="synop-flag">${s.flag}</span>${s.label}</td><td class="time">--</td><td class="code">${s.type==='SI'?'SI · Intermediate':'SM · Main'}</td><td>—</td>`;
    const rr=document.createElement('tr'); rr.className='synop-raw-row'; rr.dataset.key=s.key;
    rr.innerHTML=`<td colspan="4"><span class="synop-raw-text"></span></td>`;
    synopTbody.appendChild(tr); synopTbody.appendChild(rr);
  });
}
function parseSynopHeader(text){
  const m=text.match(/\b(S[IM][A-Z]{2}\d{2})\s+([A-Z]{4})\s+(\d{6})\b/);
  if(!m) return {timeDisplay:'--',stationCount:null};
  const tt=m[3];
  const timeDisplay=`${tt.slice(0,2)} ${tt.slice(2,4)}:${tt.slice(4,6)}Z`;
  const blocks=text.match(/\b(?:AAXX|BBXX)\s+\d+/g);
  const stnMatches=text.match(/(?:^|\s)(\d{5})\s/g);
  const approx=stnMatches?Math.max(1,Math.floor(stnMatches.length/5)):null;
  return {timeDisplay,stationCount:(blocks?blocks.length:null)||approx};
}
function renderSynopRow(source,rawText){
  const text=sanitize(rawText);
  const tr=synopTbody.querySelector(`tr[data-key="${source.key}"]:not(.synop-raw-row)`);
  const rr=synopTbody.querySelector(`tr.synop-raw-row[data-key="${source.key}"]`);
  if(!tr||!rr) return;
  const tds=tr.querySelectorAll('td');
  const h=parseSynopHeader(text);
  tds[1].textContent=h.timeDisplay;
  tds[3].textContent=h.stationCount?`${h.stationCount} stn`:'—';
  rr.querySelector('.synop-raw-text').textContent=text||'(empty)';
}
async function loadSynopRow(source){
  try{
    const out=await fetchWithRetries(source.url);
    if(out.ok){
      renderSynopRow(source,out.text);
      if(synopUpdatedEl) synopUpdatedEl.textContent=`SYNOP last updated: ${nowStamp()}`;
    }
  }catch(e){console.error('SYNOP',source.key,e);}
}
async function loadAllSynops(){await Promise.all(SYNOP_SOURCES.map(loadSynopRow));}

/* ── TEST MODE ── */
let testInterval=null;
function makeTestSamples(){
  const d=new Date();
  const ddhh=`${pad(d.getUTCDate())}${pad(d.getUTCHours())}`;
  const mm0=pad(Math.floor(d.getUTCMinutes()/10)*10);
  const t0=`${ddhh}${mm0}Z`;
  return [
    {TNCA:`TNCA ${t0} 35035G50KT 9999 VCSH FEW013CB 28/23 Q1011`,TNCB:`TNCB ${t0} 34020G35KT 0400 +TSRA FEW020CB BKN030 26/24 Q0980`,TNCC:`TNCC ${t0} 12045G60KT 0500 +TSRA FEW016TCU OVC025 27/25 Q1000`,TNCM:`TNCM ${t0} 20015G35KT 0800 SHRA FEW020TCU BKN018 25/23 Q0995`,SVMI:`SVMI ${t0} 30025G45KT 9999 VCSH FEW020CB BKN030 28/26 Q1002`,SVVA:`SVVA ${t0} 04010G20KT 0300 -SHRA FEW020 BKN025 22/21 Q1008`}
  ];
}
const TAF_TEST={
  TNCA:'TAF TNCA 011730Z 0118/0218 35025G40KT 9999 FEW020CB TX31/0215Z TN24/0206Z TEMPO 0120/0124 35035G55KT 0500 +TSRA FEW013CB BKN020 BECMG 0202/0204 12015KT 9999 FEW025 FM020600 09010KT 9999 SCT030',
  TNCB:'TAF TNCB 011730Z 0118/0218 34018G30KT 9999 SCT025 TX29/0214Z TN23/0207Z TEMPO 0119/0122 0400 +TSRA FEW018CB BKN025 PROB30 TEMPO 0122/0124 0800 SHRA SCT020',
  TNCC:'TAF TNCC 011730Z 0118/0218 12020G35KT 9999 SCT020 TX30/0215Z TN24/0206Z TEMPO 0120/0124 0500 TSRA FEW016TCU OVC025'
};
function applyTestSamples(s){
  STATIONS.forEach(icao=>{const r=s[icao]||`${icao} ${pad(new Date().getUTCDate())}${pad(new Date().getUTCHours())}00Z 09010KT 9999 FEW020 28/24 Q1013`;renderMetar(icao,r);});
  TAF_ICAOS.forEach(icao=>TAF_TEST[icao]&&renderTafRow(icao,TAF_TEST[icao]));
  if(lastUpdatedEl) lastUpdatedEl.textContent=`Test data: ${nowStamp()}`;
}
function startTest(){if(testInterval)clearInterval(testInterval);applyTestSamples(makeTestSamples()[0]);testInterval=setInterval(()=>applyTestSamples(makeTestSamples()[0]),4000);}
function stopTest(){if(testInterval){clearInterval(testInterval);testInterval=null;}}

/* ── TABS — animated switching ── */
const tabs=document.querySelectorAll('.tab-btn');
const panels={metar:$('tab-metar'),taf:$('tab-taf'),synop:$('tab-synop'),stations:$('tab-stations'),atc:$('tab-atc')};
async function switchTab(name){
  const currentPanel=Object.values(panels).find(p=>p&&!p.classList.contains('hidden'));

  tabs.forEach(t=>{
    const isTarget=t.dataset.tab===name;
    if(isTarget&&!t.classList.contains('active')){
      t.classList.add('activating');
      setTimeout(()=>t.classList.remove('activating'),600);
    }
    t.classList.toggle('active',isTarget);
  });

  const targetPanel=panels[name];
  if(currentPanel&&currentPanel!==targetPanel){
    currentPanel.classList.add('leaving');
    setTimeout(()=>{
      Object.entries(panels).forEach(([k,p])=>{
        if(p){
          p.classList.toggle('hidden',k!==name);
          p.classList.remove('leaving');
        }
      });
    },200);
  }else{
    Object.entries(panels).forEach(([k,p])=>p&&p.classList.toggle('hidden',k!==name));
  }

  if(!loadedTabs[name]){
    loadedTabs[name]=true;
    if(name==='taf') await loadAllTafs();
    else if(name==='synop') await loadAllSynops();
    else if(name==='stations') await fetchStationsData();
  }
  if(name==='stations'){
    setTimeout(()=>{if(map&&!$('stationsMapCard').classList.contains('hidden')) map.invalidateSize();},250);
  }
}
tabs.forEach(t=>t.addEventListener('click',()=>switchTab(t.dataset.tab)));

/* ── BUTTONS ── */
$('metar-refresh-btn').addEventListener('click',refreshAllMetars);
$('refresh-btn').addEventListener('click',()=>{updateVis();refreshAllMetars();if(loadedTabs.taf)loadAllTafs();if(loadedTabs.synop)loadAllSynops();});
$('taf-refresh-btn').addEventListener('click',async()=>{const b=$('taf-refresh-btn');b.disabled=true;await loadAllTafs();setTimeout(()=>b.disabled=false,800);});
$('synop-refresh-btn').addEventListener('click',async()=>{const b=$('synop-refresh-btn');b.disabled=true;await loadAllSynops();setTimeout(()=>b.disabled=false,800);});
$('vis-refresh-btn').addEventListener('click',async()=>{const b=$('vis-refresh-btn');b.disabled=true;await updateVis();setTimeout(()=>b.disabled=false,800);});
$('mute-btn').addEventListener('click',()=>{mute=!mute;const b=$('mute-btn');b.textContent=mute?'🔇 Unmute':'🔊 Mute';b.setAttribute('aria-pressed',String(mute));});
$('test-btn').addEventListener('click',()=>{testMode=!testMode;$('test-btn').textContent=testMode?'⚗ Exit':'⚗ Test';testMode?startTest():stopTest();});
$('night-btn').addEventListener('click',()=>{
  const b=$('night-btn');
  const isNight=document.documentElement.classList.toggle('night');
  b.setAttribute('aria-pressed',String(isNight));
  b.textContent=isNight?'☀ Day':'🌙 Night';
  try{localStorage.setItem('rwc-night',isNight?'1':'0');}catch(e){}
});
try{if(localStorage.getItem('rwc-night')==='1'){document.documentElement.classList.add('night');const b=$('night-btn');b.setAttribute('aria-pressed','true');b.textContent='☀ Day';}}catch(e){}

$('metar').addEventListener('click',async e=>{
  const td=e.target.closest('td'); if(!td) return;
  const tr=td.closest('tr'); if(!tr||tr.classList.contains('raw')) return;
  const text=td.textContent.trim(); if(!text) return;
  try{await navigator.clipboard.writeText(text);td.classList.add('flash-blue');setTimeout(()=>td.classList.remove('flash-blue'),600);}catch(e){}
});

setInterval(()=>{if(!testMode)refreshAllMetars();},METAR_REFRESH_MS);
setInterval(()=>{if(!testMode)updateVis();},VIS_REFRESH_MS);

/* ── STATIONS ── */
const API_BASE='https://curacao-weather-api.generast.workers.dev/';
const COORDS={
  "Curaçao International Airport":{lat:12.18889,lon:-68.95972},
  "Curacao International Airport":{lat:12.18889,lon:-68.95972},
  "Seru Mahuma":{lat:12.18330,lon:-68.93330},
  "Santa Maria":{lat:12.16720,lon:-68.93920},
  "Savonet":{lat:12.35060,lon:-69.10610},
  "Soto":{lat:12.26670,lon:-69.10000},
  "Spaanse Water":{lat:12.06730,lon:-68.85010},
  "Steenrijk":{lat:12.09788,lon:-68.91214}
};
const ISLAND_CENTER={lat:12.16957,lon:-68.99002};
const ISLAND_BOUNDS=[[11.9177,-69.5311],[12.5478,-68.3707]];
const MAP_EXCLUDE=new Set(['Klein Kwartier','Punda']);
let currentData=[], map=null, markersLayer=null;

function safeNum(v){return(v===null||v===undefined||v==='')?null:Number(v);}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function parseIso(s){if(!s)return null;const d=new Date(s);return isNaN(d)?null:d;}
function sameLocalDate(a,b){if(!a||!b)return false;return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();}
function evaluateStation(row){
  const last=parseIso(row.last_updated_iso||row.last_updated);
  const isStaleDate=!last||!sameLocalDate(new Date(),last);
  return{alerts:[],severity:isStaleDate?3:0,isStaleDate};
}
function windRoseSvg(dir,sp){
  const id=++svgIdCounter;
  if(typeof dir!=='number'||!isFinite(dir))
    return`<svg viewBox="0 0 84 84" class="wind-rose"><circle cx="42" cy="42" r="30" stroke="rgba(85,193,255,0.15)" stroke-width="1.5" fill="none"/><text x="42" y="47" fill="rgba(106,138,170,0.6)" font-size="13" text-anchor="middle" font-family="Space Mono,monospace">—</text></svg>`;
  const speed=(typeof sp==='number'&&isFinite(sp))?sp:null;
  const len=speed?Math.min(27,Math.max(6,(speed/20)*27)):10;
  const col=speed>=25?'#ff5f5f':(speed>=15?'#f59e0b':'#3fcf82');
  const toDeg=(dir+180)%360;
  return`<svg viewBox="0 0 84 84" class="wind-rose">
    <circle cx="42" cy="42" r="30" stroke="rgba(85,193,255,0.15)" stroke-width="1.5" fill="none"/>
    <g transform="translate(42,42) rotate(${toDeg})">
      <line x1="0" y1="0" x2="0" y2="${-len}" stroke="${col}" stroke-width="2.5" stroke-linecap="round"/>
      <polygon points="0,${-(len+7)} -4,${-len} 4,${-len}" fill="${col}"/>
      <circle cx="0" cy="0" r="3" fill="${col}" fill-opacity="0.7"/>
    </g>
    <text x="42" y="75" fill="rgba(200,230,255,0.7)" font-size="11" text-anchor="middle" font-family="Space Mono,monospace">${speed!==null?Math.round(speed)+' kn':'—'}</text>
  </svg>`;
}
function extractCoords(row){
  let lat=null,lon=null;
  for(const k of ['latitude','lat','lat_deg','lat_dd']){if(k in row&&row[k]!=null){lat=row[k];break;}}
  for(const k of ['longitude','lon','lon_deg','lon_dd','lng']){if(k in row&&row[k]!=null){lon=row[k];break;}}
  if(lat==null&&row.location?.lat) lat=row.location.lat;
  if(lon==null&&row.location?.lon) lon=row.location.lon;
  lat=lat!=null?Number(lat):null; lon=lon!=null?Number(lon):null;
  if(!isFinite(lat))lat=null; if(!isFinite(lon))lon=null;
  if(lat==null||lon==null){
    const name=(row.station||'').trim();
    if(COORDS[name]){lat=COORDS[name].lat;lon=COORDS[name].lon;}
  }
  return(lat!=null&&lon!=null)?{lat,lon}:null;
}
function initMap(){
  if(map) return;
  map=L.map('map',{zoomControl:true}).setView([ISLAND_CENTER.lat,ISLAND_CENTER.lon],11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OpenStreetMap'}).addTo(map);
  markersLayer=L.layerGroup().addTo(map);
  try{map.fitBounds(ISLAND_BOUNDS,{padding:[40,40]});}catch(e){}
}
function markerColor(sev){return sev===3?'#ffb3c7':(sev===2?'#ef4444':(sev===1?'#f59e0b':'#3fcf82'));}
function addMarkers(rows){
  if(!map) initMap();
  markersLayer.clearLayers();
  rows.forEach(r=>{
    if(MAP_EXCLUDE.has((r.station||'').trim())) return;
    const c=extractCoords(r); if(!c) return;
    const ev=evaluateStation(r);
    const marker=L.circleMarker([c.lat,c.lon],{radius:10,fillColor:markerColor(ev.severity),color:'#00000022',weight:1,fillOpacity:0.9});
    const wd=r.wind_direction_deg!=null?Number(r.wind_direction_deg):null;
    const ws=r.wind_speed_knots!=null?Number(r.wind_speed_knots):null;
    const popup=`<div style="display:flex;gap:10px;align-items:flex-start;min-width:240px;background:rgba(6,24,42,0.98);padding:12px;border-radius:8px;">${windRoseSvg(wd,ws)}<div style="font-family:'Barlow Condensed',sans-serif;color:#fff;"><strong style="font-size:15px;color:#55c1ff;">🇨🇼 ${escapeHtml(r.station||'—')}</strong><br/><small style="color:#8aabcc;">${escapeHtml(r.last_updated||'—')}</small><hr style="margin:8px 0;border:none;border-top:1px solid rgba(55,130,200,0.15)"/><div style="font-size:13px;"><strong>Temp:</strong> ${r.temperature_c!=null?r.temperature_c.toFixed(1)+' °C':'—'}</div><div style="font-size:13px;"><strong>Wind:</strong> ${ws!=null?ws+' kn':'—'} (${r.wind_direction_text||'—'})</div></div></div>`;
    marker.bindPopup(popup,{maxWidth:380});
    marker.addTo(markersLayer);
  });
}
function renderStations(rows){
  const list=$('stationsList');
  if(!rows.length){list.innerHTML='<div style="padding:20px;color:var(--muted);">No stations available</div>';return;}
  let alertCount=0,staleCount=0,mostRecent=null;
  list.innerHTML=rows.map(r=>{
    const ev=evaluateStation(r);
    if(ev.alerts.length) alertCount++;
    if(ev.isStaleDate) staleCount++;
    if(!mostRecent&&r.last_updated) mostRecent=r.last_updated;
    const temp=r.temperature_c!==null?r.temperature_c.toFixed(1)+'°C':'—';
    const wkn=r.wind_speed_knots!==null?r.wind_speed_knots:null;
    const wdg=r.wind_direction_deg!==null?Number(r.wind_direction_deg):null;
    const wt=r.wind_direction_text||r.wind_direction||'—';
    return`<div class="station-row">
      <div class="station-top">
        <div style="display:flex;gap:12px;align-items:center;">
          ${windRoseSvg(wdg,wkn)}
          <div>
            <div class="station-name"><span class="station-flag">🇨🇼</span>${escapeHtml(r.station)}</div>
            <div class="station-time">${escapeHtml(r.last_updated||'—')}</div>
          </div>
        </div>
        <div style="display:flex;gap:7px;">
          <div class="param"><span class="label">Temp</span><span class="value">${temp}</span></div>
          <div class="param"><span class="label">Wind</span><span class="value">${wkn!==null?wkn+' kn':'—'}</span></div>
        </div>
      </div>
      <div class="params-row">
        <div class="param"><span class="label">Heat idx</span><span class="value" style="font-size:14px;">${r.heat_index_c!=null?r.heat_index_c.toFixed(1)+'°':'—'}</span></div>
        <div class="param"><span class="label">Humidity</span><span class="value" style="font-size:14px;">${r.humidity_percent!=null?r.humidity_percent+'%':'—'}</span></div>
        <div class="param"><span class="label">Direction</span><span class="value" style="font-size:14px;">${wt}${wdg!==null?' ('+wdg+'°)':''}</span></div>
        <div class="param"><span class="label">Rain today</span><span class="value" style="font-size:14px;">${r.rain_today_mm!=null?r.rain_today_mm+' mm':'—'}</span></div>
      </div>
    </div>`;
  }).join('');
  $('totalCount').textContent=rows.length;
  $('alertCount').textContent=alertCount;
  $('staleCount').textContent=staleCount;
  $('mostRecent').textContent=mostRecent||'—';
}
async function fetchStationsData(){
  try{
    let rows=[];
    try{
      const res=await fetch(API_BASE,{cache:'no-store'});
      if(!res.ok) throw new Error('Network '+res.status);
      rows=await res.json();
    }catch(err){
      const ts=new Date().toISOString();
      rows=[
        {station:'Curaçao International Airport',temperature_c:29.1,heat_index_c:31.0,humidity_percent:74,wind_speed_knots:12,wind_direction_deg:140,wind_direction_text:'SE',rain_today_mm:0,last_updated:ts},
        {station:'Seru Mahuma',temperature_c:28.4,heat_index_c:29.5,humidity_percent:70,wind_speed_knots:8,wind_direction_deg:160,wind_direction_text:'SSE',rain_today_mm:0,last_updated:ts},
        {station:'Santa Maria',temperature_c:29.6,heat_index_c:31.2,humidity_percent:72,wind_speed_knots:10,wind_direction_deg:150,wind_direction_text:'SSE',rain_today_mm:0,last_updated:ts},
        {station:'Savonet',temperature_c:27.2,heat_index_c:27.8,humidity_percent:68,wind_speed_knots:6,wind_direction_deg:120,wind_direction_text:'ESE',rain_today_mm:0,last_updated:ts}
      ];
    }
    rows.forEach(r=>{
      r.temperature_c=safeNum(r.temperature_c);
      r.heat_index_c=safeNum(r.heat_index_c);
      r.humidity_percent=safeNum(r.humidity_percent);
      r.wind_speed_knots=safeNum(r.wind_speed_knots);
      r.wind_direction_deg=r.wind_direction_deg!=null?safeNum(r.wind_direction_deg):(r.wind_direction&&!isNaN(Number(r.wind_direction))?Number(r.wind_direction):null);
      r.rain_today_mm=safeNum(r.rain_today_mm);
      if(r.last_updated_iso) r.last_updated=r.last_updated_iso;
    });
    currentData=rows;
    const ts='Last fetched: '+new Date().toLocaleString();
    $('stationsLastFetched').textContent=ts;
    $('mapLastFetched').textContent=ts;
    renderStations(rows);
    if(map) addMarkers(rows);
  }catch(e){console.error('stations',e);}
}
$('toggleMap').addEventListener('click',()=>{
  const mc=$('stationsMapCard');
  const hidden=mc.classList.contains('hidden');
  if(hidden){mc.classList.remove('hidden');initMap();addMarkers(currentData);try{map.setView([ISLAND_CENTER.lat,ISLAND_CENTER.lon],11);setTimeout(()=>map.invalidateSize(),200);}catch(e){}}
  else mc.classList.add('hidden');
});
$('mapSearch').addEventListener('input',()=>{
  const q=$('mapSearch').value.toLowerCase();
  addMarkers(currentData.filter(r=>!q||(r.station&&r.station.toLowerCase().includes(q))));
});

/* ── ATC PLAYERS ── */
document.querySelectorAll('.atc-player').forEach(card=>{
  const url=card.dataset.stream;
  const btn=card.querySelector('.atc-play-btn');
  const icon=card.querySelector('.atc-play-icon');
  const txt=card.querySelector('.atc-status-text');
  const vol=card.querySelector('.atc-vol-slider');
  const audio=new Audio(); audio.preload='none'; audio.crossOrigin='anonymous'; audio.volume=vol.value/100;
  function setState(s){
    card.classList.remove('loading','playing','error');
    if(s) card.classList.add(s);
    icon.textContent=s==='loading'?'◐':(s==='playing'?'■':'▶');
    txt.textContent=s==='loading'?'Connecting':(s==='playing'?'Live':(s==='error'?'Error':'Idle'));
  }
  audio.addEventListener('playing',()=>setState('playing'));
  audio.addEventListener('waiting',()=>setState('loading'));
  audio.addEventListener('pause',()=>{if(!audio.ended)setState(null);});
  audio.addEventListener('error',()=>setState('error'));
  audio.addEventListener('stalled',()=>setState('loading'));
  btn.addEventListener('click',()=>{
    if(audio.paused){
      audio.src=url+'?t='+Date.now();
      setState('loading');
      audio.play().catch(()=>setState('error'));
    }else{audio.pause();audio.src='';setState(null);}
  });
  vol.addEventListener('input',()=>audio.volume=vol.value/100);
});

/* ── INIT ── */
buildMetarTable();
buildTafTable();
buildSynopTable();
loadedTabs.metar=true;

(async function init(){
  try{
    Promise.allSettled([updateVis(),refreshAllMetars()]).then(()=>{
      const any=STATIONS.some(icao=>metarState[icao]?.lastRaw);
      if(!any){
        console.warn('No live data — test mode');
        testMode=true; startTest();
        $('test-btn').textContent='⚗ Exit';
      }
    });
  }catch(e){console.error('init',e);testMode=true;startTest();}
})();

window.__rwc={refreshAllMetars,updateVis,loadAllTafs,loadAllSynops,renderMetar,renderTafRow,switchTab};
})();
</script>
</body>
</html>
